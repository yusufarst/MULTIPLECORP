{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "typecheck": "tsc --noEmit && tsc --noEmit -p tests/Browser && tsc --noEmit -p tests/Frontend",
        "lint": "eslint .",
        "test:lint-rules": "node --test \"eslint/**/*.test.js\"",
        "test:frontend": "node --test \"tests/Frontend/**/*.test.ts\"",
        "test:browser": "playwright test -c tests/Browser/playwright.config.ts",
        "scan:secrets": "sh scripts/ci/scan-secrets.sh"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@date-fns/tz": "1.4.1",
        "@fontsource-variable/inter": "5.3.0",
        "@fontsource/roboto": "5.3.0",
        "@inertiajs/react": "3.9.1",
        "class-variance-authority": "0.7.1",
        "clsx": "2.1.1",
        "date-fns": "4.1.0",
        "lucide-react": "1.56.0",
        "mustache": "4.2.0",
        "react": "19.3.1",
        "react-day-picker": "10.0.2",
        "react-dom": "19.3.1",
        "tailwind-merge": "3.7.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.64.1",
        "@secretlint/secretlint-rule-preset-recommend": "13.0.7",
        "@tailwindcss/vite": "4.3.3",
        "@types/mustache": "4.2.6",
        "@types/node": "24.19.2",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.1.2",
        "eslint": "10.13.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "globals": "17.13.0",
        "laravel-vite-plugin": "3.2.0",
        "secretlint": "13.0.7",
        "tailwindcss": "4.3.3",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vite": "8.3.4"
    }
}
