# MULTIPLECORP's production image (TASK-072; INFRASTRUCTURE §4.1; DIR-117): the PHP runtime of docker/php/Dockerfile with
# the code and the built frontend inside, no development dependency or tooling (SECURITY SX-03; WS-10), OPcache on and
# the PHP version hidden, run as the unprivileged www-data. One image serves the web workers (php-fpm), the two queue
# workers and the scheduler (deploy/coolify/compose.yml). Every base image pinned by digest (SX-05). Its build context is
# the repository, filtered by Dockerfile.production.dockerignore; the development image keeps its empty context.
FROM composer:2.10.3@sha256:af98f42dfff7c68ba8d53c2164fd9fde1087b7d449514baa38c418b1f6bc4bac AS composer

# The frontend built from the lockfile (TL-13's build).
FROM node:24.22.0-alpine3.24@sha256:44fce696f38ba8c987c4db89954051000bbd05ffd8d8659ba15ed4a8602e937f AS assets
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM php:8.5.11-fpm-alpine3.24@sha256:fa01fb1645cd0fc566a5f146b099adace33b906571f972f71f2182a7c12d1cd7
# The extensions and the renderer of docker/php/Dockerfile (TASK-022; DIR-099), and production's php.ini.
RUN set -eux; \
    apk add --no-cache libpq unzip libjpeg-turbo libpng libwebp libzip weasyprint=68.1-r1 font-dejavu=2.37-r6; \
    apk add --no-cache --virtual .build-deps $PHPIZE_DEPS libpq-dev libjpeg-turbo-dev libpng-dev libwebp-dev libzip-dev; \
    docker-php-ext-configure gd --with-jpeg --with-webp; \
    docker-php-ext-install -j"$(nproc)" pdo_pgsql gd zip; \
    apk del --no-network .build-deps; \
    cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"; \
    { \
        echo 'expose_php = Off'; \
        echo 'opcache.enable = 1'; \
        echo 'opcache.validate_timestamps = 0'; \
        echo 'opcache.memory_consumption = 192'; \
        echo 'opcache.max_accelerated_files = 20000'; \
    } > "$PHP_INI_DIR/conf.d/zz-multiplecorp.ini"; \
    { \
        echo '[www]'; \
        echo 'pm = ${PHP_FPM_PM}'; \
        echo 'pm.max_children = ${PHP_FPM_MAX_CHILDREN}'; \
        echo 'pm.start_servers = ${PHP_FPM_START_SERVERS}'; \
        echo 'pm.min_spare_servers = ${PHP_FPM_MIN_SPARE}'; \
        echo 'pm.max_spare_servers = ${PHP_FPM_MAX_SPARE}'; \
        echo 'clear_env = no'; \
    } > /usr/local/etc/php-fpm.d/zz-multiplecorp.conf; \
    php -m | grep -qx pdo_pgsql; \
    php -m | grep -qx gd; \
    php -m | grep -qx zip; \
    weasyprint --version
# php-fpm's pool size is configuration, its values from TASK-079's measurement (SZ-01–SZ-04); these are the defaults.
ENV PHP_FPM_PM=dynamic PHP_FPM_MAX_CHILDREN=10 PHP_FPM_START_SERVERS=3 PHP_FPM_MIN_SPARE=2 PHP_FPM_MAX_SPARE=5

WORKDIR /var/www/html
COPY --from=composer /usr/bin/composer /usr/local/bin/composer
COPY composer.json composer.lock ./
RUN COMPOSER_HOME=/tmp/composer composer install --no-dev --no-interaction --prefer-dist --no-progress --no-scripts --no-autoloader
COPY . .
COPY --from=assets /build/public/build public/build
RUN set -eux; \
    COMPOSER_HOME=/tmp/composer composer dump-autoload --no-dev --optimize --classmap-authoritative; \
    rm -rf /usr/local/bin/composer /tmp/composer; \
    mkdir -p storage/app storage/framework/cache storage/framework/sessions storage/framework/views storage/logs bootstrap/cache; \
    chown -R www-data:www-data storage bootstrap/cache; \
    chmod -R o-rwx storage
USER www-data
