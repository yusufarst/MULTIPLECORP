# The one-shot `db-roles` step of staging and production (TASK-072; INFRASTRUCTURE §4.4; TASK-078's staging findings):
# the server's own image with the roles script built in, so the stack mounts nothing from the repository. Coolify
# resolves a relative bind mount against its own resource directory, never against the compose file's
# (docs/09-operations/COOLIFY_DEPLOYMENT.md §3).
FROM postgres:18.6-alpine3.24@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
COPY docker/postgres/provision-roles.sh /opt/postgres/provision-roles.sh
