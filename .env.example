# Local development and CI values for the Docker Compose stack of DEVELOPMENT.md.
# Placeholders only: never put a real secret, credential or host here (SECURITY SX-01).
APP_NAME=MULTIPLECORP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:8443

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=multiplecorp
DB_USERNAME=multiplecorp
DB_PASSWORD=change-me-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=cache
REDIS_PASSWORD=change-me-local-only
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
