# Local environment values. Only sanitized examples may be committed.
.env
.env.*
!.env.example
!.env.*.example

# Credentials and private key material.
*.pem
*.key
*.p12
*.pfx
*.keystore
credentials*.json
secrets/

# Real business data and recovery artifacts are not repository content.
backups/
private-data/
imports/private/
uploads/
*.dump
*.backup
*.sql.gz

# Local logs and machine clutter.
*.log
Thumbs.db
.DS_Store

# The application's installed and generated files (TASK-001).
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage
/.phpunit.cache/
.phpunit.result.cache
/auth.json

# The browser suite's reports, traces and screenshots (TASK-003).
/storage/test-results/
