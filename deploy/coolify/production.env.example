# MULTIPLECORP's environment for a Coolify resource — staging or production (TASK-072; SECURITY SX-01, SX-03; INFRASTRUCTURE
# §4.2, §4.3; DIR-117). PLACEHOLDERS ONLY: the operator enters every value in the resource's environment variables in
# Coolify, each secret marked secret there, never in this repository, a chat, a ticket or a log. Each environment has its
# own values; none is shared with the second application. deploy/coolify/compose.yml names each variable it requires.

# The release being deployed: the tag or the short commit of a verified `main` commit (RELEASE_PLAN; TASK-073).
MULTIPLECORP_RELEASE=v0.0.0

# The application (WS-10; SX-03): production settings, never debug or profiling. APP_ENV is `production` on production and
# `staging` on staging; the image tag carries it, so the two environments never share a build.
APP_ENV=production
APP_URL=https://app.example.invalid
APP_KEY=base64:REPLACE_WITH_php_artisan_key_generate_--show
# WS-11: only the proxy in front of MULTIPLECORP — Coolify's proxy on the stack's network — and only the configured domain.
APP_TRUSTED_PROXIES=REPLACE_WITH_THE_EDGE_NETWORK_RANGE
APP_TRUSTED_HOSTS=app.example.invalid
# WS-08 on staging: `true` first, the policy report-only with its reports to /laporan-csp, then `false` once the reports
# are clean; always `false` on production.
CSP_REPORT_ONLY=false
# The application's own domain, one of APP_TRUSTED_HOSTS: web's health check names it.
MULTIPLECORP_HOST=app.example.invalid
LOG_LEVEL=info
# WS-06's HSTS stages: max-age=300, then max-age=604800, then max-age=31536000; includeSubDomains once every subdomain serves HTTPS.
MULTIPLECORP_HSTS=max-age=300

# The database (DATABASE §28; INFRASTRUCTURE §4.4): the runtime login of web and workers, here. The server's bootstrap
# superuser, used only by db and db-roles; the migration/owner login, used only by the migration step and never given to a
# running process; and the administration login for GuardMaintenance and restore verification only — db-roles provisions
# it, and the operator gives it to `guards:maintain` for that run alone (COOLIFY_DEPLOYMENT §6) — are NOT variables here:
# Coolify gives every service every variable of the resource, so they are files in the credentials directory below.
DB_DATABASE=multiplecorp
DB_USERNAME=REPLACE
DB_PASSWORD=REPLACE

# The operator's credentials directory on the VPS, this environment's own (COOLIFY_DEPLOYMENT §5): an absolute path outside
# Coolify's directories and the repository, holding six one-line files — superuser/username, superuser/password,
# migration/username, migration/password, admin/username, admin/password. Each directory is mounted read-only into the
# services that use it alone: superuser into db and db-roles, migration into db-roles and migrate, admin into db-roles.
MULTIPLECORP_CREDENTIALS_DIR=/REPLACE/WITH/THE/CREDENTIALS/DIRECTORY

# Valkey (H9-09): its own password, never the second application's.
REDIS_PASSWORD=REPLACE

# The security log's HMAC key (LG-03): the application refuses sign-in without it (fail closed).
SECURITY_LOG_HMAC_KEY=REPLACE

# Google sign-in (AU-22; TASK-082): each environment's own OAuth client, its redirect URI on APP_URL.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resource limits per service (SZ-01–SZ-04): TASK-079's measured values replace these defaults, inside OPI-27's reservations.
APP_CPUS=1.0
APP_MEMORY=768M
WORKER_CPUS=0.5
WORKER_MEMORY=512M
SCHEDULER_CPUS=0.25
SCHEDULER_MEMORY=256M
WEB_CPUS=0.5
WEB_MEMORY=128M
DB_CPUS=1.0
DB_MEMORY=1536M
CACHE_CPUS=0.25
CACHE_MEMORY=256M
# Valkey's own ceiling, about three quarters of CACHE_MEMORY, so a full store refuses writes instead of being killed.
CACHE_MAXMEMORY=192mb
PHP_FPM_MAX_CHILDREN=10
