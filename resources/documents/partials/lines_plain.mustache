{{#has_lines}}<table class="paper-lines">
<thead><tr><th class="num">No.</th><th>Uraian</th><th class="qty">Jumlah</th><th>Satuan</th><th>Keterangan</th></tr></thead>
<tbody>
{{#lines}}<tr><td class="num">{{no}}</td><td>{{description}}</td><td class="qty">{{quantity}}</td><td>{{unit}}</td><td>{{note}}</td></tr>
{{/lines}}
</tbody>
</table>{{/has_lines}}
