{{> open}}
<div class="paper-heading"><h2 class="paper-title">Berita Acara Pemeriksaan Barang</h2>{{> number}}</div>
{{> meta}}
<p class="paper-text">Pada tanggal {{date}} telah dilakukan pemeriksaan barang berikut dengan hasil sebagaimana tercatat:</p>
{{> lines_plain}}
<div class="paper-signatures">
<div class="paper-signature"><p>&nbsp;</p><p>Pemeriksa,</p><p>{{#recipient}}{{name}}{{/recipient}}</p><div class="paper-signature-space"></div><span class="paper-signer-blank"></span><p>Nama dan tanda tangan</p></div>
{{> issuer_signature}}
</div>
{{> close}}
