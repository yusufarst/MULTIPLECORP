{{> open}}
<div class="paper-heading"><h2 class="paper-title">Berita Acara Serah Terima</h2>{{> number}}</div>
{{> meta}}
<p class="paper-text">Pada tanggal {{date}}, {{issuer.name}} (Pihak Pertama) telah menyerahkan kepada {{#recipient}}{{name}}{{/recipient}} (Pihak Kedua) barang/pekerjaan berikut, dan Pihak Kedua telah menerimanya:</p>
{{> lines_plain}}
<p class="paper-note">Berita acara ini dibuat sesuai fakta serah terima yang tercatat dan ditandatangani kedua pihak.</p>
<div class="paper-signatures">
<div class="paper-signature"><p>&nbsp;</p><p>Pihak Kedua,</p><p>{{#recipient}}{{name}}{{/recipient}}</p><div class="paper-signature-space"></div><span class="paper-signer-blank"></span><p>Nama dan tanda tangan</p></div>
{{> issuer_signature}}
</div>
{{> close}}
